{
  "name": "MAX Number Checker API",
  "slug": "max-number-checker-api",
  "description": "Bulk asynchronous file-based API used to verify MAX messenger registration and optionally retrieve documented profile fields.",
  "canonical_docs": "https://docs.checknumber.ai/max-checker",
  "dashboard": "https://platform.checknumber.ai",
  "base_url": "https://api.checknumber.ai",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "file_format": "text; one E.164 phone number per line, or one email per line for email task types"
  },
  "result_fields": [
    {
      "field": "Number",
      "description": "Phone number in E.164 format",
      "example": "+79991234567"
    },
    {
      "field": "max",
      "description": "Whether the number is registered on MAX messenger",
      "example": "yes, no"
    }
  ],
  "products": [
    {
      "task_type": "max",
      "name": "MAX Number Checker",
      "doc_slug": "max-checker",
      "input_kind": "phone"
    },
    {
      "task_type": "max_full",
      "name": "MAX Full Profile Checker",
      "doc_slug": "max-full-checker",
      "input_kind": "phone"
    }
  ],
  "pricing_url": "https://checknumber.ai/pricing",
  "last_updated": "2026-07-13"
}
